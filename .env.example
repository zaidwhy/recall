# Recall — environment template. Copy to `.env` and fill in.
# IMPORTANT: keep billing OFF on this Gemini project — enabling billing deletes the free tier.

# Free-tier Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Models (verified June 2026 — adjust if newer flash/live ids ship)
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-live

# Server
HOST=0.0.0.0
PORT=8000
